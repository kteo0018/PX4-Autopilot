    <!-- Trees around grass patches (avoiding bottom-left spawn area near 0,0) -->
    <include>
      <uri>https://fuel.ignitionrobotics.org/1.0/OpenRobotics/models/Oak Tree</uri>
      <name>oak_tree_1</name>
      <pose>25 -15 0 0 0 1.57</pose>
