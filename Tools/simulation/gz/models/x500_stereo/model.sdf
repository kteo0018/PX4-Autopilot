<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='x500_custom_stereo'>
    <!-- Include the complete x500 model (with motor plugins) -->
    <include merge='true'>
      <uri>x500</uri>
    </include>

    <!-- Left Camera for Visual SLAM -->
    <link name='camera_left_link'>
      <pose>0.12 0 0.05 0 0 0</pose>
      <collision name='camera_left_collision'>
        <geometry>
          <box>
            <size>0.04 0.04 0.04</size>
          </box>
        </geometry>
      </collision>
      <visual name='camera_left_visual'>
        <geometry>
          <box>
            <size>0.04 0.04 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.8 0.8 1</ambient>
          <diffuse>0.8 0.8 0.8 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <inertial>
        <mass>0.008</mass>
        <inertia>
          <ixx>0.000008</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000008</iyy>
          <iyz>0</iyz>
          <izz>0.000008</izz>
        </inertia>
      </inertial>
      <sensor name='camera_left' type='camera'>
        <camera>
          <horizontal_fov>1.39626</horizontal_fov>  <!-- 80 degrees -->
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.005</stddev>
          </noise>
          <!-- Optimized distortion parameters for OpenVINS -->
          <distortion>
            <k1>0.0</k1>
            <k2>0.0</k2>
            <k3>0.0</k3>
            <p1>0.0</p1>
            <p2>0.0</p2>
          </distortion>
          <!-- Optimized lens parameters -->
          <lens>
            <type>stereographic</type>
            <scale_to_hfov>true</scale_to_hfov>
            <cutoff_angle>1.570796</cutoff_angle>
            <env_texture_size>256</env_texture_size>
            <intrinsics>
              <fx>320.0</fx>
              <fy>240.0</fy>
              <cx>320.0</cx>
              <cy>240.0</cy>
              <s>0.0</s>
            </intrinsics>
          </lens>
        </camera>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <topic>world/z_my_forest/model/x500_custom_stereo_0/link/camera_left_link/sensor/camera_left/image</topic>
      </sensor>
    </link>

    <!-- Right Camera for Stereo Vision -->
    <link name='camera_right_link'>
      <pose>0.12 0.08 0.05 0 0 0</pose>  <!-- 8cm to the right -->
      <collision name='camera_right_collision'>
        <geometry>
          <box>
            <size>0.04 0.04 0.04</size>
          </box>
        </geometry>
      </collision>
      <visual name='camera_right_visual'>
        <geometry>
          <box>
            <size>0.04 0.04 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.8 0.8 1</ambient>
          <diffuse>0.8 0.8 0.8 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <inertial>
        <mass>0.008</mass>
        <inertia>
          <ixx>0.000008</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000008</iyy>
          <iyz>0</iyz>
          <izz>0.000008</izz>
        </inertia>
      </inertial>
      <sensor name='camera_right' type='camera'>
        <camera>
          <horizontal_fov>1.39626</horizontal_fov>  <!-- 80 degrees -->
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.005</stddev>
          </noise>
          <!-- Optimized distortion parameters for OpenVINS -->
          <distortion>
            <k1>0.0</k1>
            <k2>0.0</k2>
            <k3>0.0</k3>
            <p1>0.0</p1>
            <p2>0.0</p2>
          </distortion>
          <!-- Optimized lens parameters -->
          <lens>
            <type>stereographic</type>
            <scale_to_hfov>true</scale_to_hfov>
            <cutoff_angle>1.570796</cutoff_angle>
            <env_texture_size>256</env_texture_size>
            <intrinsics>
              <fx>320.0</fx>
              <fy>240.0</fy>
              <cx>320.0</cx>
              <cy>240.0</cy>
              <s>0.0</s>
            </intrinsics>
          </lens>
        </camera>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <topic>world/z_my_forest/model/x500_custom_stereo_0/link/camera_right_link/sensor/camera_right/image</topic>
      </sensor>
    </link>

    <!-- GPS Sensor - Top center of drone -->
    <link name='gps_link'>
      <pose>0 0 0.15 0 0 0</pose>
      <collision name='gps_collision'>
        <geometry>
          <sphere>
            <radius>0.015</radius>
          </sphere>
        </geometry>
      </collision>
      <visual name='gps_visual'>
        <geometry>
          <sphere>
            <radius>0.015</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.2 0.8 0.2 1</ambient>
          <diffuse>0.2 0.8 0.2 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <inertial>
        <mass>0.003</mass>
        <inertia>
          <ixx>0.000003</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000003</iyy>
          <iyz>0</iyz>
          <izz>0.000003</izz>
        </inertia>
      </inertial>
      <sensor name='gps' type='gps'>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <topic>world/z_my_forest/model/x500_custom_stereo_0/link/gps_link/sensor/gps/navsat</topic>
        <gps>
          <horizontal_position_noise>0.05</horizontal_position_noise>
          <vertical_position_noise>0.05</vertical_position_noise>
          <horizontal_velocity_noise>0.05</horizontal_velocity_noise>
          <vertical_velocity_noise>0.05</vertical_velocity_noise>
        </gps>
      </sensor>
    </link>

    <!-- IMU Sensor - Center of drone body -->
    <link name='imu_link'>
      <pose>0 0 0.08 0 0 0</pose>
      <collision name='imu_collision'>
        <geometry>
          <box>
            <size>0.025 0.025 0.025</size>
          </box>
        </geometry>
      </collision>
      <visual name='imu_visual'>
        <geometry>
          <box>
            <size>0.025 0.025 0.025</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.2 0.2 1</ambient>
          <diffuse>0.8 0.2 0.2 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <inertial>
        <mass>0.005</mass>
        <inertia>
          <ixx>0.000005</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000005</iyy>
          <iyz>0</iyz>
          <izz>0.000005</izz>
        </inertia>
      </inertial>
      <sensor name='imu' type='imu'>
        <always_on>true</always_on>
        <update_rate>200</update_rate>
        <visualize>false</visualize>
        <topic>world/z_my_forest/model/x500_custom_stereo_0/link/imu_link/sensor/imu/imu</topic>
        <imu>
          <angular_velocity>
            <x>
              <noise type='gaussian'>
                <mean>0.0</mean>
                <stddev>0.0002</stddev>
                <bias_mean>0.0000075</bias_mean>
                <bias_stddev>0.0000008</bias_stddev>
              </noise>
            </x>
            <y>
              <noise type='gaussian'>
                <mean>0.0</mean>
                <stddev>0.0002</stddev>
                <bias_mean>0.0000075</bias_mean>
                <bias_stddev>0.0000008</bias_stddev>
              </noise>
            </y>
            <z>
              <noise type='gaussian'>
                <mean>0.0</mean>
                <stddev>0.0002</stddev>
                <bias_mean>0.0000075</bias_mean>
                <bias_stddev>0.0000008</bias_stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type='gaussian'>
                <mean>0.0</mean>
                <stddev>0.017</stddev>
                <bias_mean>0.1</bias_mean>
                <bias_stddev>0.001</bias_stddev>
              </noise>
            </x>
            <y>
              <noise type='gaussian'>
                <mean>0.0</mean>
                <stddev>0.017</stddev>
                <bias_mean>0.1</bias_mean>
                <bias_stddev>0.001</bias_stddev>
              </noise>
            </y>
            <z>
              <noise type='gaussian'>
                <mean>0.0</mean>
                <stddev>0.017</stddev>
                <bias_mean>0.1</bias_mean>
                <bias_stddev>0.001</bias_stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>

    <!-- Joints to connect sensors to base -->
    <joint name='camera_left_joint' type='fixed'>
      <parent>base_link</parent>
      <child>camera_left_link</child>
    </joint>

    <joint name='camera_right_joint' type='fixed'>
      <parent>base_link</parent>
      <child>camera_right_link</child>
    </joint>

    <joint name='gps_joint' type='fixed'>
      <parent>base_link</parent>
      <child>gps_link</child>
    </joint>

    <joint name='imu_joint' type='fixed'>
      <parent>base_link</parent>
      <child>imu_link</child>
    </joint>

  </model>
</sdf>
