<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='x500_custom'>
    <!-- Include the complete x500 model (with motor plugins) -->
    <include merge='true'>
      <uri>x500</uri>
    </include>

    <!-- Angled (forward + down) camera for low-altitude ORB-SLAM3 -->
    <link name='camera_link'>
      <pose>0.12 0 0.05 0 0.349066 0</pose>
      <collision name='camera_collision'>
        <geometry>
          <box>
            <size>0.04 0.04 0.04</size>
          </box>
        </geometry>
      </collision>
      <visual name='camera_visual'>
        <geometry>
          <box>
            <size>0.04 0.04 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.8 0.8 1</ambient>
          <diffuse>0.8 0.8 0.8 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <inertial>
        <mass>0.008</mass>
        <inertia>
          <ixx>0.000008</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000008</iyy>
          <iyz>0</iyz>
          <izz>0.000008</izz>
        </inertia>
      </inertial>
      <sensor name='camera' type='camera'>
        <camera>
          <horizontal_fov>1.5708</horizontal_fov>  <!-- 90 degrees -->
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.005</stddev>
          </noise>
        </camera>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <!-- <topic>custom_x500/sensor/camera/image</topic> -->
      </sensor>
    </link>

    <!-- RGB-D Sensor (color + depth) for ORB-SLAM3 RGBD -->
    <link name='rgbd_link'>
      <!-- <pose>0.12 0 0.05 0 0.349066 0</pose> -->
      <pose>0 0 .10 0 1.5707 0</pose>
      <collision name='rgbd_collision'>
        <geometry>
          <box>
            <size>0.04 0.04 0.04</size>
          </box>
        </geometry>
      </collision>
      <visual name='rgbd_visual'>
        <geometry>
          <box>
            <size>0.04 0.04 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>0.6 0.6 0.9 1</ambient>
          <diffuse>0.6 0.6 0.9 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00001</iyy>
          <iyz>0</iyz>
          <izz>0.00001</izz>
        </inertia>
      </inertial>
      <sensor name='rgbd' type='rgbd_camera'>
        <always_on>true</always_on>
        <update_rate>60</update_rate>
        <visualize>false</visualize>
        <!-- <topic>custom_x500/sensor/rgbd</topic> -->
        <camera>
          <horizontal_fov>1.5708</horizontal_fov> <!-- 90 deg, wider FOV -->
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <depth_camera>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <output_format>FLOAT32</output_format>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.003</stddev>
          </noise>
        </depth_camera>
      </sensor>
    </link>

    <!-- GPS Sensor - Top center of drone -->
    <link name='gps_link'>
      <pose>0 0 0.15 0 0 0</pose>
      <collision name='gps_collision'>
        <geometry>
          <sphere>
            <radius>0.015</radius>
          </sphere>
        </geometry>
      </collision>
      <visual name='gps_visual'>
        <geometry>
          <sphere>
            <radius>0.015</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.2 0.8 0.2 1</ambient>
          <diffuse>0.2 0.8 0.2 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <inertial>
        <mass>0.003</mass>
        <inertia>
          <ixx>0.000003</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000003</iyy>
          <iyz>0</iyz>
          <izz>0.000003</izz>
        </inertia>
      </inertial>
      <sensor name='gps' type='gps'>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <!-- <topic>custom_x500/sensor/gps/navsat</topic> -->
        <gps>
          <horizontal_position_noise>0.05</horizontal_position_noise>
          <vertical_position_noise>0.05</vertical_position_noise>
          <horizontal_velocity_noise>0.05</horizontal_velocity_noise>
          <vertical_velocity_noise>0.05</vertical_velocity_noise>
        </gps>
      </sensor>
    </link>

    <!-- IMU Sensor - Center of drone body -->
    <link name='imu_link'>
      <pose>0 0 0.08 0 0 0</pose>
      <collision name='imu_collision'>
        <geometry>
          <box>
            <size>0.025 0.025 0.025</size>
          </box>
        </geometry>
      </collision>
      <visual name='imu_visual'>
        <geometry>
          <box>
            <size>0.025 0.025 0.025</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.2 0.2 1</ambient>
          <diffuse>0.8 0.2 0.2 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <inertial>
        <mass>0.005</mass>
        <inertia>
          <ixx>0.000005</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000005</iyy>
          <iyz>0</iyz>
          <izz>0.000005</izz>
        </inertia>
      </inertial>
      <sensor name='imu' type='imu'>
        <always_on>true</always_on>
        <update_rate>200</update_rate>
        <visualize>false</visualize>
        <!-- <topic>custom_x500/sensor/imu/imu</topic> -->
        <imu>
          <angular_velocity>
            <x>
              <noise type='gaussian'>
                <mean>0.0</mean>
                <stddev>0.0002</stddev>
                <bias_mean>0.0000075</bias_mean>
                <bias_stddev>0.0000008</bias_stddev>
              </noise>
            </x>
            <y>
              <noise type='gaussian'>
                <mean>0.0</mean>
                <stddev>0.0002</stddev>
                <bias_mean>0.0000075</bias_mean>
                <bias_stddev>0.0000008</bias_stddev>
              </noise>
            </y>
            <z>
              <noise type='gaussian'>
                <mean>0.0</mean>
                <stddev>0.0002</stddev>
                <bias_mean>0.0000075</bias_mean>
                <bias_stddev>0.0000008</bias_stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type='gaussian'>
                <mean>0.0</mean>
                <stddev>0.017</stddev>
                <bias_mean>0.1</bias_mean>
                <bias_stddev>0.001</bias_stddev>
              </noise>
            </x>
            <y>
              <noise type='gaussian'>
                <mean>0.0</mean>
                <stddev>0.017</stddev>
                <bias_mean>0.1</bias_mean>
                <bias_stddev>0.001</bias_stddev>
              </noise>
            </y>
            <z>
              <noise type='gaussian'>
                <mean>0.0</mean>
                <stddev>0.017</stddev>
                <bias_mean>0.1</bias_mean>
                <bias_stddev>0.001</bias_stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>

    <!-- Joints to connect sensors to base -->
    <joint name='camera_joint' type='fixed'>
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>

    <joint name='rgbd_joint' type='fixed'>
      <parent>base_link</parent>
      <child>rgbd_link</child>
    </joint>

    <joint name='gps_joint' type='fixed'>
      <parent>base_link</parent>
      <child>gps_link</child>
    </joint>

    <joint name='imu_joint' type='fixed'>
      <parent>base_link</parent>
      <child>imu_link</child>
    </joint>

    <!-- Odometry Publisher Plugin -->
    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
    </plugin>

  </model>
</sdf>
